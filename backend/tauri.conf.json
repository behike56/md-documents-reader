{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Reader",
  "version": "0.1.0",
  "identifier": "com.behike56.markdown-reader",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Reader",
        "width": 960,
        "height": 720,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
